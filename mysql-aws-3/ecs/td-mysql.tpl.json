{
  "family": "bdget-mysql",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::767397846878:role/LabRole",
  "taskRoleArn": "arn:aws:iam::767397846878:role/LabRole",
  "containerDefinitions": [
    {
      "name": "mysql",
      "image": "mysql:8.0",
      "essential": true,
      "portMappings": [
        {
          "name": "mysql",
          "containerPort": 3306,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "value": "bdget_root_pass"
        },
        {
          "name": "MYSQL_DATABASE",
          "value": "bdget_db"
        },
        {
          "name": "MYSQL_USER",
          "value": "bdget_user"
        },
        {
          "name": "MYSQL_PASSWORD",
          "value": "bdget_pass"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "mysqladmin ping -h 127.0.0.1 -u root -p$MYSQL_ROOT_PASSWORD || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bdget",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "mysql"
        }
      }
    }
  ]
}
